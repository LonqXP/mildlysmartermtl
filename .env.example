# Safe remote Google Gemma configuration. Copy to .env and replace the token locally.
LLM_BACKEND=huggingface

# Use a deployed Hugging Face endpoint or the hosted Gemma model ID below.
# The endpoint must support Hugging Face chat completions. If both are set, the endpoint wins.
HF_ENDPOINT_URL=
HF_MODEL_ID=google/gemma-3-4b-it
HF_TOKEN=your_huggingface_token_here
HF_TIMEOUT_SECONDS=120
HF_MAX_NEW_TOKENS=512

APP_DATA_DIR=.runtime
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
