# Local llama.cpp OpenAI-compatible server configuration.
LLM_BACKEND=llamacpp
LLAMACPP_BASE_URL=http://127.0.0.1:1234
LLAMACPP_MODEL=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
# Model source metadata only; llama.cpp loads the already-running local model.
# Source repository: https://huggingface.co/unsloth/Qwen3.6-35B-A3B-GGUF
LLAMACPP_API_KEY=
LLAMACPP_CONNECT_TIMEOUT_SECONDS=5
LLAMACPP_READ_TIMEOUT_SECONDS=600
LLAMACPP_ANALYSIS_MAX_TOKENS=2048
LLAMACPP_TRANSLATION_MAX_TOKENS=8192
LLAMACPP_TRANSLATION_BATCH_CHARS=10000
LLAMACPP_DISABLE_THINKING=true
LLAMACPP_JSON_MODE=true
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

APP_DATA_DIR=.runtime
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
MAX_MODEL_INPUT_CHARS=30000
